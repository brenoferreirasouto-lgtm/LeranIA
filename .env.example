# Copie para .env e ajuste. Nunca faça commit do .env.

# Banco PostgreSQL (o docker-compose.yml sobe um com estes dados)
DATABASE_URL=postgres://learnai:localdev@localhost:5432/learn_ai

# Segredo usado para assinar a sessão. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Endereço público da aplicação
BETTER_AUTH_URL=http://localhost:3000
